{
  "name": "pure-memo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:embedding && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "concurrently -k \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175/desktop.html && PURE_DEV_URL=http://127.0.0.1:5175 PURE_DEV_DATA_DIR=.dev-data electron .\"",
    "desktop:built": "vite build && electron .",
    "test:desktop": "node --test desktop/*.test.cjs src/*.test.js",
    "test:sandbox": "node desktop/sandbox-check.cjs",
    "build:embedding": "node native/build-embedding.cjs",
    "eval:ask-retrieval": "npm run build:embedding && node eval/ask-retrieval.cjs",
    "eval:ask-answers": "npm run build:embedding && node eval/ask-answers.cjs",
    "eval:memory": "node eval/memory-compare.cjs",
    "eval:memory-holdout": "node eval/memory-holdout-eval.cjs",
    "eval:longitudinal": "node eval/longitudinal-eval.cjs",
    "eval:answer-quality": "node eval/answer-quality.cjs --live",
    "eval:answer-quality:prepare": "node eval/answer-quality.cjs",
    "eval:memory-live": "node eval/memory-holdout-eval.cjs --live"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "vite": "^6.0.0",
    "wait-on": "^9.0.1"
  },
  "main": "desktop/main.cjs",
  "productName": "pure.",
  "license": "MIT",
  "engines": {
    "node": ">=24.6.0"
  }
}

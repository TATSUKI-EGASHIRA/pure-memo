{
  "name": "pure-memo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:embedding && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "concurrently -k \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175/desktop.html && PURE_DEV_URL=http://127.0.0.1:5175 PURE_DEV_DATA_DIR=.dev-data electron .\"",
    "desktop:built": "vite build && electron .",
    "test:desktop": "node --test desktop/*.test.cjs src/*.test.js",
    "test:sandbox": "node desktop/sandbox-check.cjs",
    "build:embedding": "node native/build-embedding.cjs",
    "eval:ask-retrieval": "npm run build:embedding && node eval/ask-retrieval.cjs",
    "eval:ask-answers": "npm run build:embedding && node eval/ask-answers.cjs",
    "eval:memory": "node eval/memory-compare.cjs",
    "eval:memory-holdout": "node eval/memory-holdout-eval.cjs",
    "eval:longitudinal": "node eval/longitudinal-eval.cjs",
    "eval:answer-quality": "node eval/answer-quality.cjs --live",
    "eval:answer-quality:prepare": "node eval/answer-quality.cjs",
    "eval:memory-live": "node eval/memory-holdout-eval.cjs --live",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "eval": "npm run build:embedding && node eval/product-eval.cjs",
    "eval:simulate": "npm run build:embedding && node eval/simulate-use.cjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0",
    "wait-on": "^9.0.1"
  },
  "main": "desktop/main.cjs",
  "productName": "pure.",
  "license": "MIT",
  "engines": {
    "node": ">=24.6.0"
  },
  "build": {
    "appId": "app.pure.memo",
    "productName": "pure",
    "copyright": "Copyright © 2026 pure.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*.cjs",
      "!desktop/**/*.test.cjs",
      "dist/**",
      "native/*-helper",
      "package.json",
      "!node_modules/**"
    ],
    "asarUnpack": [
      "native/*-helper"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "pure. reads the URL and title of the browser tab you capture from.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "pure. capture",
            "CFBundleURLSchemes": [
              "pure"
            ]
          }
        ],
        "CFBundleDisplayName": "pure."
      }
    },
    "dmg": {
      "title": "pure.",
      "artifactName": "pure-${version}-${arch}.dmg"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "description": "Local-first AI memo app for macOS."
}
